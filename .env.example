# Never commit a real key. This optional server credential stays off the client.
TYPESAFE_API_KEY=replace_with_your_typesafe_key
PORT=8787

# Public web deployments: set false so anonymous visitors can never spend the
# server owner's key. Visitors connect their own key through a short server-only
# session instead.
JEV_ALLOW_ENVIRONMENT_KEY=false

# Required by production / Vercel API instances. This is a 32-byte base64url
# secret used only to encrypt short-lived Jev-session and measurement tickets.
# Generate a fresh value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never reuse TYPESAFE_API_KEY here and never expose this via VITE_ variables.
JEV_STATE_ENCRYPTION_KEY=replace_with_a_32_byte_base64url_secret

# Exact browser origins allowed to call a separately hosted API. Do not use *.
# CORS_ALLOWED_ORIGINS=https://your-github-user.github.io

# Public build values for GitHub Pages. These are URLs / paths, never secrets.
# VITE_API_BASE_URL=https://api.example.com
# VITE_BASE_PATH=/your-repository-name/

# All values are clamped to safe upper limits by the server.
JEV_SESSION_TTL_MINUTES=15
JEV_SESSION_IDLE_MINUTES=5
JEV_SESSION_MAX_CALLS=20
JEV_CONNECTION_ATTEMPTS=5

# Set when TLS terminates at one trusted reverse proxy so Express can enforce
# HTTPS on the API-key connection endpoint.
# TRUST_PROXY=1
# HOST=0.0.0.0
